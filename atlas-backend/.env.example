# Exemplo de arquivo de configuraÃ§Ã£o de ambiente para o atlas Backend
# Copie este arquivo para .env na raiz do backend e altere os valores conforme necessÃ¡rio.
# ATENÃ‡ÃƒO: Nunca envie chaves e senhas reais para o Git!

# URL de conexÃ£o com o banco de dados PostgreSQL (Exemplo com NeonDB Cloud)
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/nome_banco?sslmode=require&uselibpqcompat=true"

# Segredo usado para assinar os tokens JWT (Use uma chave forte e longa em produÃ§Ã£o)
JWT_SECRET="sua_chave_secreta_aqui"

# Porta em que o backend vai escutar localmente
PORT=3000

# Origem permitida nas requisiÃ§Ãµes CORS (endereÃ§o do frontend)
FRONTEND_URL="http://localhost:4200"

# ConfiguraÃ§Ãµes de IntegraÃ§Ã£o de Login (LDAP + SGA)
USE_MOCK_AUTH="false" # true para habilitar somente os testes locais aprovados
API_LDAP="https://ldap.api.pm.pe.gov.br/api/"
LDAP_AUTH_ENDPOINT="auth" # ex: auth, login, etc.
SGA_API_URL="https://sga.sistemas.pm.pe.gov.br/api"
SGA_SYSTEM_TOKEN="seu_token_de_servico_sga_aqui"

