# -------------------------------------------------
# Backend (NestJS) – variáveis usadas em atlas-backend
# -------------------------------------------------
PORT=3000                     # porta padrão do NestJS
DATABASE_URL=postgresql://<USER>:<PASS>@<HOST>:5432/atlas   # ajuste ao seu DB
USE_MOCK_AUTH=true           # habilita modo mock (pode ser false em produção)
FRONTEND_URL=https://atlas-frontend.vercel.app   # URL do front que o gateway de notificações usa

# -------------------------------------------------
# Frontend (Angular) – variáveis que o Angular lê via environment.ts
# -------------------------------------------------
API_URL=https://atlas-backend.vercel.app   # endpoint do backend na Vercel
MOCK_AUTH=true                # desabilita mock quando rodando na Vercel

# -------------------------------------------------
# Outras integrações (LDAP / SGA) – se precisar de credenciais
# -------------------------------------------------
LDAP_URL=ldap://<ldap-host>:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your_ldap_password

SGA_URL=https://<sga-host>/api
SGA_TOKEN=your_sga_token

# -------------------------------------------------
# JWT / segurança
# -------------------------------------------------
JWT_SECRET=super_secret_jwt_key_here
JWT_EXPIRES_IN=3600

# -------------------------------------------------
# Notificações (Socket.io)
# -------------------------------------------------
NOTIFICATIONS_NAMESPACE=/notificacoes
